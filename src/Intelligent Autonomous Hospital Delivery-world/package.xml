<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>aws_robomaker_hospital_world</name>
  <version>2.0.0</version>
  <description>
    Hospital Delivery Robot — TurtleBot3 Waffle with SLAM, Nav2, and autonomous
    medicine delivery in an AWS RoboMaker hospital environment.
  </description>
  <license>Apache 2.0</license>
  <author email="etsubdinkzebre09@gmail.com">etsubit6</author>
  <maintainer email="etsubdinkzebre09@gmail.com">etsubit6</maintainer>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher</exec_depend>
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>slam_toolbox</exec_depend>
  <exec_depend>navigation2</exec_depend>
  <exec_depend>nav2_smac_planner</exec_depend>
  <exec_depend>rclpy</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
