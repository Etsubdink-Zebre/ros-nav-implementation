<?xml version="1.0" ?>
<!--
  TurtleBot3 Waffle — Gazebo Harmonic (gz-sim 8) compatible URDF
  ==============================================================
  Based on the official ROBOTIS TurtleBot3 Waffle model, adapted for
  Gazebo Harmonic (gz::sim) plugins instead of Gazebo Classic.

  Uses meshes from nav2_minimal_tb3_sim (installed with ros-jazzy-nav2-bringup).
-->
<robot name="turtlebot3_waffle" xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:arg name="namespace" default=""/>
  <xacro:property name="ns" value="$(arg namespace)"/>

  <!-- ════════════════════════════════════════════════════════════════════
       Material definitions
       ════════════════════════════════════════════════════════════════════ -->
  <material name="black">  <color rgba="0.0 0.0 0.0 1.0"/> </material>
  <material name="dark">   <color rgba="0.3 0.3 0.3 1.0"/> </material>
  <material name="light_black"> <color rgba="0.4 0.4 0.4 1.0"/> </material>
  <material name="green">  <color rgba="0.0 0.8 0.0 1.0"/> </material>
  <material name="grey">   <color rgba="0.5 0.5 0.5 1.0"/> </material>
  <material name="orange"> <color rgba="1.0 0.42 0.04 1.0"/> </material>
  <material name="white">  <color rgba="1.0 1.0 1.0 1.0"/> </material>

  <!-- ════════════════════════════════════════════════════════════════════
       Robot dimensions (metres) — Official TurtleBot3 Waffle
       ════════════════════════════════════════════════════════════════════ -->
  <xacro:property name="base_x"  value="0.281"/>
  <xacro:property name="base_y"  value="0.306"/>
  <xacro:property name="base_z"  value="0.141"/>
  <xacro:property name="wheel_r" value="0.033"/>
  <xacro:property name="wheel_w" value="0.018"/>
  <xacro:property name="wheel_sep" value="0.287"/>
  <xacro:property name="caster_x" value="-0.177"/>

  <!-- ════════════════════════════════════════════════════════════════════
       base_footprint  (the ground-projection frame)
       ════════════════════════════════════════════════════════════════════ -->
  <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child  link="base_link"/>
    <origin xyz="0 0 0.010" rpy="0 0 0"/>
  </joint>

  <!-- ════════════════════════════════════════════════════════════════════
       base_link  (chassis)
       ════════════════════════════════════════════════════════════════════ -->
  <link name="base_link">
    <visual>
      <origin xyz="-0.064 0 0.0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://nav2_minimal_tb3_sim/models/turtlebot3_model/meshes/waffle_base.dae" scale="1.0 1.0 1.0"/>
      </geometry>
      <material name="light_black"/>
    </visual>
    <collision>
      <origin xyz="-0.064 0 0.048" rpy="0 0 0"/>
      <geometry>
        <box size="${base_x} ${base_y} ${base_z}"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.3729096"/>
      <inertia ixx="0.0122" ixy="0" ixz="0" iyy="0.0122" iyz="0" izz="0.0171"/>
    </inertial>
  </link>

  <!-- ════════════════════════════════════════════════════════════════════
       Left wheel
       ════════════════════════════════════════════════════════════════════ -->
  <joint name="wheel_left_joint" type="continuous">
    <parent link="base_link"/>
    <child  link="wheel_left_link"/>
    <origin xyz="0.0 ${wheel_sep/2} 0.023" rpy="-1.5708 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>
  <link name="wheel_left_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <mesh filename="package://nav2_minimal_tb3_sim/models/turtlebot3_model/meshes/tire.dae" scale="1.0 1.0 1.0"/>
      </geometry>
      <material name="dark"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="${wheel_r}" length="${wheel_w}"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="0.1"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>

  <!-- ════════════════════════════════════════════════════════════════════
       Right wheel
       ════════════════════════════════════════════════════════════════════ -->
  <joint name="wheel_right_joint" type="continuous">
    <parent link="base_link"/>
    <child  link="wheel_right_link"/>
    <origin xyz="0.0 -${wheel_sep/2} 0.023" rpy="-1.5708 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>
  <link name="wheel_right_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <mesh filename="package://nav2_minimal_tb3_sim/models/turtlebot3_model/meshes/tire.dae" scale="1.0 1.0 1.0"/>
      </geometry>
      <material name="dark"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="${wheel_r}" length="${wheel_w}"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="0.1"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>

  <!-- ════════════════════════════════════════════════════════════════════
       Caster (ball) — passive support
       ════════════════════════════════════════════════════════════════════ -->
  <joint name="caster_back_right_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="caster_back_right_link"/>
    <origin xyz="${caster_x} -0.064 -0.004" rpy="0 0 0"/>
  </joint>
  <link name="caster_back_right_link">
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><sphere radius="0.005"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="0.001"/>
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
    </inertial>
  </link>

  <joint name="caster_back_left_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="caster_back_left_link"/>
    <origin xyz="${caster_x} 0.064 -0.004" rpy="0 0 0"/>
  </joint>
  <link name="caster_back_left_link">
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><sphere radius="0.005"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="0.001"/>
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
    </inertial>
  </link>

  <!-- ════════════════════════════════════════════════════════════════════
       LDS (Lidar) sensor
       ════════════════════════════════════════════════════════════════════ -->
  <joint name="scan_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="base_scan"/>
    <origin xyz="-0.064 0 0.122" rpy="0 0 0"/>
  </joint>
  <link name="base_scan">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://nav2_minimal_tb3_sim/models/turtlebot3_model/meshes/lds.dae" scale="1.0 1.0 1.0"/>
      </geometry>
      <material name="dark"/>
    </visual>
    <collision>
      <origin xyz="0.015 0 -0.0065" rpy="0 0 0"/>
      <geometry><cylinder radius="0.0508" length="0.055"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="0.114"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>

  <!-- ════════════════════════════════════════════════════════════════════
       Camera (Intel R200)
       ════════════════════════════════════════════════════════════════════ -->
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="camera_link"/>
    <origin xyz="0.064 -0.065 0.094" rpy="0 0 0"/>
  </joint>
  <link name="camera_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 1.5708"/>
      <geometry>
        <mesh filename="package://nav2_minimal_tb3_sim/models/turtlebot3_model/meshes/r200.dae" scale="1.0 1.0 1.0"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.02 0.12 0.03"/></geometry>
    </collision>
  </link>

  <joint name="camera_rgb_joint" type="fixed">
    <parent link="camera_link"/>
    <child  link="camera_rgb_frame"/>
    <origin xyz="0.005 0.018 0.013" rpy="0 0 0"/>
  </joint>
  <link name="camera_rgb_frame"/>

  <joint name="camera_rgb_optical_joint" type="fixed">
    <parent link="camera_rgb_frame"/>
    <child  link="camera_rgb_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/>
  </joint>
  <link name="camera_rgb_optical_frame"/>

  <!-- ════════════════════════════════════════════════════════════════════
       IMU sensor frame
       ════════════════════════════════════════════════════════════════════ -->
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="imu_link"/>
    <origin xyz="0.0 0 0.068" rpy="0 0 0"/>
  </joint>
  <link name="imu_link"/>

  <!-- ════════════════════════════════════════════════════════════════════
       GAZEBO HARMONIC (gz-sim 8) PLUGINS
       ════════════════════════════════════════════════════════════════════ -->
  <gazebo>
    <!-- Differential drive controller -->
    <plugin filename="gz-sim-diff-drive-system"
            name="gz::sim::systems::DiffDrive">
      <left_joint>wheel_left_joint</left_joint>
      <right_joint>wheel_right_joint</right_joint>
      <wheel_separation>${wheel_sep}</wheel_separation>
      <wheel_radius>${wheel_r}</wheel_radius>
      <max_linear_acceleration>1.0</max_linear_acceleration>
      <min_linear_acceleration>-1.0</min_linear_acceleration>
      <max_angular_acceleration>2.0</max_angular_acceleration>
      <min_angular_acceleration>-2.0</min_angular_acceleration>
      <max_linear_velocity>0.26</max_linear_velocity>
      <max_angular_velocity>1.82</max_angular_velocity>
      <odom_topic>odom</odom_topic>
      <tf_topic>tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <odom_publish_frequency>30</odom_publish_frequency>
    </plugin>

    <!-- Joint state publisher -->
    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
      <joint_name>wheel_left_joint</joint_name>
      <joint_name>wheel_right_joint</joint_name>
      <topic>joint_states</topic>
    </plugin>
  </gazebo>

  <!-- Lidar sensor -->
  <gazebo reference="base_scan">
    <sensor name="hls_lfcd_lds" type="gpu_lidar">
      <always_on>true</always_on>
      <update_rate>5</update_rate>
      <visualize>true</visualize>
      <topic>scan</topic>
      <gz_frame_id>base_scan</gz_frame_id>
      <lidar>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>0</min_angle>
            <max_angle>6.28</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.12</min>
          <max>12.0</max>
          <resolution>0.015</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </lidar>
    </sensor>
  </gazebo>

  <!-- IMU sensor -->
  <gazebo reference="imu_link">
    <sensor name="tb3_imu" type="imu">
      <always_on>true</always_on>
      <update_rate>200</update_rate>
      <topic>imu</topic>
      <gz_frame_id>imu_link</gz_frame_id>
      <imu>
        <angular_velocity>
          <x><noise type="gaussian"><mean>0</mean><stddev>0.0002</stddev></noise></x>
          <y><noise type="gaussian"><mean>0</mean><stddev>0.0002</stddev></noise></y>
          <z><noise type="gaussian"><mean>0</mean><stddev>0.0002</stddev></noise></z>
        </angular_velocity>
        <linear_acceleration>
          <x><noise type="gaussian"><mean>0</mean><stddev>0.017</stddev></noise></x>
          <y><noise type="gaussian"><mean>0</mean><stddev>0.017</stddev></noise></y>
          <z><noise type="gaussian"><mean>0</mean><stddev>0.017</stddev></noise></z>
        </linear_acceleration>
      </imu>
    </sensor>
  </gazebo>

  <!-- Camera sensor -->
  <gazebo reference="camera_rgb_frame">
    <sensor name="camera" type="camera">
      <always_on>true</always_on>
      <update_rate>15</update_rate>
      <topic>camera/image_raw</topic>
      <gz_frame_id>camera_rgb_optical_frame</gz_frame_id>
      <camera>
        <horizontal_fov>1.085595</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.03</near>
          <far>100</far>
        </clip>
      </camera>
    </sensor>
  </gazebo>

  <!-- Sensor system plugin (required for all sensors in Harmonic) -->
  <gazebo>
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system"
            name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-contact-system"
            name="gz::sim::systems::Contact"/>
  </gazebo>

</robot>
